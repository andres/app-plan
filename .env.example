# Copy to .env on the server and fill in. Never commit .env.

# Domain(s) pointing at the droplet (DNS A records), comma-separated. Caddy gets HTTPS for each.
DOMAIN=plan.example.com

# Password to log in to the planner.
APP_PASSWORD=change-me

# Optional, for "Push to GitHub". Fine-grained token with Administration + Contents: read/write.
GITHUB_TOKEN=
# Default owner for new repos, e.g. your GitHub username.
GITHUB_OWNER=
